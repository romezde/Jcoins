PORT=4000
JCOINS_STORAGE_MODE=supabase
JCOINS_DATA_DIR=
RUN_SCHEDULED_JOBS=true
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d
CORS_ORIGINS=https://jcoins-zeta.vercel.app,https://coins-zeta.vercel.app,http://localhost:5173

# Optional Web Push override. With Supabase enabled, JCoins securely generates and stores
# stable VAPID keys automatically when these are left blank.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://jcoins-zeta.vercel.app

# Supabase backend storage.
# Use the Project URL, not the dashboard URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Backend only. Never put this in the React client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_STATE_TABLE=jcoins_app_state

# Daily backup schedule. Default is Philippine time.
BACKUP_TIME_ZONE=Asia/Manila
BACKUP_RETENTION_DAYS=30
JCOINS_BACKUP_MIRROR_DIR=

# Optional Google Drive grade-sheet sync. For a personal My Drive, use OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# For a Google Workspace Shared Drive, a service account can be used instead.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_GRADE_FOLDER_ID=
